+// Voice processing changes AVAudioEngine's I/O units. Configure it only after
+// AVAudioSession is active and while the engine is stopped, so the live input
+// and output formats are established first. This is required by AVAudioIONode
+// and avoids creating a graph against the previous session's device format.
+- (BOOL)configureVoiceProcessingIfNeeded:(NSError **)outError
+{
+  const BOOL shouldEnable =
+      audioapi::usesVoiceProcessingProfile() &&
+      self.sessionManager.desiredMode == AVAudioSessionModeVoiceChat;
+  AVAudioInputNode *inputNode = self.audioEngine.inputNode;
+
+  if (inputNode.isVoiceProcessingEnabled == shouldEnable) {
+    return YES;
+  }
+
+  NSError *error = nil;
+  if (![inputNode setVoiceProcessingEnabled:shouldEnable error:&error]) {
+    NSLog(@"[AudioEngine] Failed to %@ voice processing: %@",
+          shouldEnable ? @"enable" : @"disable", error);
+    if (outError != nil) {
+      *outError = error;
     }
+    return NO;
   }
+
+  return YES;
 }
 
