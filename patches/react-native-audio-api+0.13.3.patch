--- a/android/src/main/cpp/audioapi/android/core/AudioPlayer.cpp
+++ b/android/src/main/cpp/audioapi/android/core/AudioPlayer.cpp
@@ -31,10 +31,22 @@
 bool AudioPlayer::openAudioStream() {
   AudioStreamBuilder builder;
 
-  builder.setSharingMode(SharingMode::Exclusive)
+  // Oboe defaults output to Usage::Media, which puts playback on the media
+  // stream: media volume slider, media routing, and nothing the platform echo
+  // canceller references. VoiceCommunication maps to
+  // AudioAttributes.USAGE_VOICE_COMMUNICATION, so playback lands on the call
+  // stream instead, which is what makes it visible to the HAL canceller.
+  //
+  // Shared + None keeps the stream off the MMAP fast path. That path is
+  // exclusive of the mixer where communication pre/post-processing lives, so
+  // asking for low latency here would opt back out of the very processing we
+  // want. A few ms of added latency is irrelevant next to network round trips.
+  builder.setSharingMode(SharingMode::Shared)
       ->setFormat(AudioFormat::Float)
       ->setFormatConversionAllowed(true)
-      ->setPerformanceMode(PerformanceMode::LowLatency)
+      ->setPerformanceMode(PerformanceMode::None)
+      ->setUsage(Usage::VoiceCommunication)
+      ->setContentType(ContentType::Speech)
       ->setChannelCount(channelCount_)
       ->setSampleRateConversionQuality(SampleRateConversionQuality::Medium)
       ->setFramesPerDataCallback(RENDER_QUANTUM_SIZE)
--- a/android/src/main/cpp/audioapi/android/core/AndroidAudioRecorder.cpp
