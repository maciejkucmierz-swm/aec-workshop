   self.audioEngine = [[AVAudioEngine alloc] init];
+
+  // AVAudioSessionModeVoiceChat only describes the kind of session. Apple
+  // applies its actual AEC/NS/AGC voice path to AVAudioEngine only after the
+  // I/O node opts in to voice processing. Do this before the input is
+  // connected or the engine is started; each graph rebuild gets a new engine
+  // and therefore needs the opt-in again.
+  if (self.sessionManager.desiredMode == AVAudioSessionModeVoiceChat) {
