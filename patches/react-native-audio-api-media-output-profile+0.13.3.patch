         [](jsi::Runtime &, const jsi::Value &, const jsi::Value *args, size_t count) {
-          voiceProcessingProfileEnabled.store(
-              count > 0 && args[0].isBool() && args[0].getBool(), std::memory_order_release);
+          const int selected =
+              count > 0 && args[0].isNumber() ? static_cast<int>(args[0].getNumber()) : 0;
+          const auto profile = selected == 1 ? AudioStreamProfile::UpstreamDefaults
+              : selected == 2 ? AudioStreamProfile::MediaOutput
+                              : AudioStreamProfile::VoiceProcessing;
+          audioStreamProfile.store(profile, std::memory_order_release);
           return jsi::Value::undefined();
         });
 
