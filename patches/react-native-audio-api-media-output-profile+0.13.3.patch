index 5f5f7d2..9ea7b5a 100644
--- a/common/cpp/audioapi/core/utils/VoiceProcessingProfile.h
+++ b/common/cpp/audioapi/core/utils/VoiceProcessingProfile.h
@@ -5,7 +5,28 @@
 namespace audioapi {
 
+enum class AudioStreamProfile : int {
+  VoiceProcessing = 0,
+  UpstreamDefaults = 1,
+  MediaOutput = 2,
+};
+
 // Selected before a live context or recorder opens its native stream.
 // Default to the app's patched voice profile to preserve existing behavior.
-inline std::atomic_bool voiceProcessingProfileEnabled{true};
+inline std::atomic<AudioStreamProfile> audioStreamProfile{AudioStreamProfile::VoiceProcessing};
+
+inline bool usesVoiceProcessingProfile() {
+  return audioStreamProfile.load(std::memory_order_acquire) ==
+      AudioStreamProfile::VoiceProcessing;
+}
+
+inline bool usesVoiceInputProfile() {
+  return audioStreamProfile.load(std::memory_order_acquire) !=
+      AudioStreamProfile::UpstreamDefaults;
+}
+
+inline bool usesVoiceOutputProfile() {
+  return audioStreamProfile.load(std::memory_order_acquire) ==
+      AudioStreamProfile::VoiceProcessing;
+}
 
 } // namespace audioapi
