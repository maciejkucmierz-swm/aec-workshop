diff --git a/ios/audioapi/ios/AudioAPIModule.mm b/ios/audioapi/ios/AudioAPIModule.mm
--- a/ios/audioapi/ios/AudioAPIModule.mm
+++ b/ios/audioapi/ios/AudioAPIModule.mm
@@ -282,13 +282,45 @@ RCT_EXPORT_METHOD(
     setCommunicationDevice : (NSString *)device resolve : (RCTPromiseResolveBlock)
         resolve reject : (RCTPromiseRejectBlock)reject)
 {
-  resolve(nil);
+  // AEC workshop iOS communication routing: query the real route, not the request.
+  dispatch_async(dispatch_get_main_queue(), ^{
+    AVAudioSessionPortOverride override;
+    if ([device isEqualToString:@"speaker"]) {
+      override = AVAudioSessionPortOverrideSpeaker;
+    } else if ([device isEqualToString:@"earpiece"] || [device isEqualToString:@"systemDefault"]) {
+      override = AVAudioSessionPortOverrideNone;
+    } else {
+      reject(@"invalid_communication_device", @"Unknown communication device", nil);
+      return;
+    }
+
+    NSError *error = nil;
+    if (![[AVAudioSession sharedInstance] overrideOutputAudioPort:override error:&error]) {
+      reject(@"communication_route_failed", error.localizedDescription, error);
+      return;
+    }
+    resolve(nil);
+  });
 }
 
 RCT_EXPORT_METHOD(
     getCommunicationDevice : (RCTPromiseResolveBlock)resolve reject : (RCTPromiseRejectBlock)reject)
 {
-  resolve(@"");
+  dispatch_async(dispatch_get_main_queue(), ^{
+    NSArray<AVAudioSessionPortDescription *> *outputs = [AVAudioSession sharedInstance].currentRoute.outputs;
+    for (AVAudioSessionPortDescription *output in outputs) {
+      if ([output.portType isEqualToString:AVAudioSessionPortBuiltInReceiver]) {
+        resolve(@"earpiece");
+        return;
+      }
+      if ([output.portType isEqualToString:AVAudioSessionPortBuiltInSpeaker]) {
+        resolve(@"speaker");
+        return;
+      }
+    }
+    // External routes are reported as-is, never mislabeled as a built-in output.
+    resolve(outputs.firstObject.portName ?: @"");
+  });
 }
 
 RCT_EXPORT_METHOD(
